{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://femboypuppy.github.io/Tessera-Notes/plugins/registry.schema.json",
  "title": "Tessera plugin registry",
  "description": "A list of plugins Tessera can browse and install (Settings → Plugins → Browse). Tessera validates every entry and skips invalid ones.",
  "type": "object",
  "required": ["version", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "maxLength": 100 },
    "updatedAt": { "type": "string", "maxLength": 40 },
    "plugins": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "author",
          "description",
          "repo",
          "version",
          "download",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[-.][a-z0-9]+)*$",
            "minLength": 2,
            "maxLength": 64,
            "description": "Must equal the id in the plugin's manifest."
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 60 },
          "author": { "type": "string", "minLength": 1, "maxLength": 100 },
          "description": { "type": "string", "maxLength": 500 },
          "repo": { "type": "string", "format": "uri", "pattern": "^https://" },
          "version": {
            "type": "string",
            "description": "Semantic version; must equal the manifest's version."
          },
          "download": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "description": "A .zip of the plugin, or its manifest.json with the entry next to it. The server must send Access-Control-Allow-Origin: *."
          },
          "permissions": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^(pages:read|pages:write|databases:read|databases:write|ui:commands|ui:panels|ui:blocks|storage|network:(\\*\\.)?[a-z0-9.-]+(:\\d{1,5})?)$"
            },
            "description": "The manifest may not ask for anything that isn't listed here."
          },
          "icon": { "type": "string", "maxLength": 16 },
          "apiVersion": { "type": "integer", "minimum": 1 },
          "minAppVersion": { "type": "string" },
          "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
          "tags": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "minLength": 1, "maxLength": 30 }
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 of the zip at download. Tessera refuses a download that doesn't match."
          }
        }
      }
    }
  }
}
