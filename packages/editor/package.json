{
  "name": "@tessera/editor",
  "version": "0.0.0",
  "private": true,
  "description": "Tessera block editor: TipTap on Yjs, implementing the canonical document schema.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@tessera/core": "workspace:*",
    "@tessera/ui": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/extension-drag-handle": "3.31.3",
    "@tiptap/extension-drag-handle-react": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-node-range": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3",
    "@tiptap/y-tiptap": "3.0.9",
    "lowlight": "3.3.0",
    "lucide-react": "1.47.0",
    "y-prosemirror": "1.3.7",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
