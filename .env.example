# Tessera server settings, read by docker-compose.yml. Copy to `.env` and edit.
# Every variable is documented in apps/server/README.md.

# Image tag to run (a release like 0.1.0, or latest).
TESSERA_VERSION=latest

# The address people use to reach Tessera (links in invites, the desktop app, CORS).
PUBLIC_URL=http://localhost:8787

# Who can create an account: invite (invite links only), open, or closed.
SIGNUP_MODE=invite

# Largest attachment, in megabytes.
MAX_UPLOAD_MB=25

# fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# Port and interface on the host. With the https profile, use TESSERA_BIND=127.0.0.1.
TESSERA_PORT=8787
TESSERA_BIND=0.0.0.0

# --- Only for `docker compose --profile https up -d` (Caddy with automatic HTTPS) ---
# The domain pointing at this machine; Caddy gets a certificate for it.
TESSERA_DOMAIN=notes.example.com
